{
  "version": 1,
  "templates": {
    "frame": "<!doctype html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"x-apple-disable-message-reformatting\"><meta name=\"color-scheme\" content=\"light\"><title>{{title}}</title>\n<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->\n<style>[[css]]</style></head>\n<body style=\"margin:0;padding:0;width:100%;background-color:#e8dccf;color:#263c30;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">{{preheader}}</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#e8dccf\" style=\"width:100%;background-color:#e8dccf;\"><tr><td class=\"outer-pad\" align=\"center\" style=\"padding:28px 12px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#faf8f5\" class=\"email-shell\" style=\"width:100%;max-width:600px;background-color:#faf8f5;border:1px solid #d8cebd;border-radius:14px;border-collapse:separate;\">\n<tr><td height=\"4\" bgcolor=\"#b69a62\" style=\"height:4px;font-size:1px;line-height:4px;background-color:#b69a62;\">&nbsp;</td></tr>\n<tr><td class=\"content-pad\" style=\"padding:26px 28px 0;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-bottom:1px solid #dcd5c8;\"><tr>\n<td width=\"60\" valign=\"middle\" style=\"width:60px;padding:0 10px 20px 0;\"><img src=\"{{logo}}\" width=\"46\" height=\"46\" alt=\"Nestora Home\" style=\"display:block;width:46px;height:46px;border:0;\"></td>\n<td valign=\"middle\" style=\"padding:0 0 20px;\"><p style=\"margin:0;color:#263c30;font-size:16px;line-height:22px;font-weight:bold;letter-spacing:.4px;\">NESTORA HOME</p><p style=\"margin:3px 0 0;color:#74806e;font-size:10px;line-height:16px;letter-spacing:1.2px;\">HOME ESSENTIALS</p></td>\n<td class=\"header-label\" align=\"right\" valign=\"middle\" style=\"padding:0 0 20px 8px;color:#74806e;font-size:9px;line-height:14px;letter-spacing:.5px;\">{{documentLabel}}</td>\n</tr></table></td></tr>\n<tr><td class=\"content-pad\" style=\"padding:24px 28px 28px;\">[[content]]</td></tr>\n<tr><td class=\"content-pad\" align=\"center\" style=\"padding:20px 28px 24px;border-top:1px solid #dcd5c8;color:#74806e;font-size:11px;line-height:18px;\">\n<p style=\"margin:0 0 5px;color:#526548;\">Thoughtfully chosen for your home.</p><p style=\"margin:0;\">Nestora Home &middot; <a href=\"mailto:info@nestorahomelb.com\" style=\"color:#526548;text-decoration:underline;\">info@nestorahomelb.com</a></p>\n</td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
    "section": "<h1 style=\"margin:0 0 12px;color:#263c30;font-size:23px;line-height:30px;font-weight:bold;\">{{heading}}</h1>\n<p style=\"margin:0 0 18px;color:#586955;font-size:14px;line-height:22px;\">{{introduction}}</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;margin-bottom:20px;\"><tr>\n<td valign=\"top\" style=\"padding:0 12px 0 0;color:#74806e;font-size:11px;line-height:18px;\">ORDER NUMBER<br><strong style=\"color:#263c30;font-size:13px;word-break:break-word;\">#{{orderNumber}}</strong></td>\n<td align=\"right\" valign=\"top\" style=\"padding:0;color:#74806e;font-size:11px;line-height:18px;\">ORDER DATE<br><span style=\"color:#526548;font-size:12px;\">{{date}}</span></td>\n</tr></table>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#e2e7dd\" style=\"width:100%;background-color:#e2e7dd;border:1px solid #d5ddcc;border-radius:10px;\"><tr><td align=\"center\" style=\"padding:20px 12px;\">\n<p style=\"margin:0 0 7px;color:#526548;font-size:12px;line-height:18px;\">Order total &middot; {{currency}}</p>\n<p style=\"margin:0 0 15px;color:#263c30;font-size:32px;line-height:38px;font-weight:bold;\">{{total}}</p>\n<table role=\"presentation\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td aria-disabled=\"true\" align=\"center\" bgcolor=\"#c1cbb8\" style=\"padding:11px 24px;border:1px solid #adbba2;border-radius:6px;background-color:#c1cbb8;color:#334b36;font-size:14px;line-height:20px;font-weight:bold;\">{{paymentAction}}<br><span style=\"font-size:10px;line-height:16px;font-weight:normal;\">{{paymentActionNote}}</span></td></tr></table>\n</td></tr></table>\n<h2 style=\"margin:25px 0 3px;color:#263c30;font-size:17px;line-height:24px;\">Order summary</h2>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;table-layout:fixed;\">[[rows]]</table>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;margin-top:14px;\">[[totals]]</table>\n<h2 style=\"margin:24px 0 9px;color:#263c30;font-size:15px;line-height:22px;\">{{detailsHeading}}</h2>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;table-layout:fixed;\">[[details]]</table>\n[[action]]\n<p style=\"margin:23px 0 5px;color:#526548;font-size:13px;line-height:21px;\">{{closing}}</p>\n<p style=\"margin:0;color:#74806e;font-size:11px;line-height:18px;\">{{paymentNotice}}</p>\n",
    "item": "<tr>\n<td class=\"thumbnail-cell\" width=\"74\" valign=\"top\" style=\"width:74px;padding:17px 10px 17px 0;border-bottom:1px solid #ded8cc;\">[[thumbnail]]</td>\n<td valign=\"middle\" style=\"padding:17px 9px 17px 0;border-bottom:1px solid #ded8cc;word-break:break-word;\">\n<p style=\"margin:0 0 5px;color:#263c30;font-size:14px;line-height:21px;font-weight:bold;\">{{name}}</p>\n<p style=\"margin:0;color:#74806e;font-size:11px;line-height:18px;white-space:pre-line;\">{{variant}}</p>\n<p style=\"margin:5px 0 0;color:#74806e;font-size:12px;line-height:18px;\">Qty: {{quantity}} &times; {{unit}}</p>\n<p style=\"margin:3px 0 0;color:#6b7d5e;font-size:10px;line-height:16px;font-weight:bold;\">{{badge}}</p>\n</td>\n<td class=\"amount-cell\" width=\"90\" align=\"right\" valign=\"middle\" style=\"width:90px;padding:17px 0;border-bottom:1px solid #ded8cc;color:#263c30;font-size:14px;line-height:21px;font-weight:bold;white-space:nowrap;\">{{total}}</td>\n</tr>\n",
    "detail": "<tr><td valign=\"top\" style=\"padding:6px 12px 6px 0;color:#74806e;font-size:12px;line-height:20px;word-break:break-word;\">{{label}}</td><td align=\"right\" valign=\"top\" style=\"padding:6px 0;color:#334b36;font-size:12px;line-height:20px;white-space:pre-line;word-break:break-word;\">{{value}}</td></tr>\n",
    "action": "<p style=\"margin:19px 0 0;font-size:12px;line-height:20px;\"><a href=\"{{url}}\" style=\"color:#526548;text-decoration:underline;\">{{label}}</a></p>\n",
    "receipt": "<h1 style=\"margin:0 0 14px;color:#263c30;font-size:23px;line-height:30px;\">{{receiptHeading}}</h1>\n<p style=\"margin:0 0 20px;color:#586955;font-size:14px;line-height:23px;\">{{receiptBody}}</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#e2e7dd\" style=\"width:100%;background-color:#e2e7dd;border:1px solid #d5ddcc;border-radius:10px;\"><tr><td style=\"padding:21px 20px;color:#526548;font-size:13px;line-height:22px;\">{{receiptNotice}}</td></tr></table>\n<p style=\"margin:22px 0 0;color:#74806e;font-size:12px;line-height:20px;\">No online payment action is available in this email.</p>\n",
    "image": "<img class=\"product-image\" src=\"{{imageUrl}}\" width=\"64\" height=\"64\" alt=\"{{name}}\" style=\"display:block;width:64px;height:64px;border:1px solid #eee9df;border-radius:10px;background-color:#ffffff;object-fit:contain;\">\n",
    "imagePlaceholder": "<table role=\"presentation\" class=\"product-image\" width=\"64\" height=\"64\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:64px;height:64px;background-color:#eee9df;border-radius:10px;\"><tr><td align=\"center\" valign=\"middle\" style=\"color:#8b8e7b;font-size:10px;line-height:14px;\">No image<br>available</td></tr></table>\n",
    "grandTotal": "<tr><td style=\"padding:17px 12px 3px 0;border-top:1px solid #cfc5b3;color:#263c30;font-size:17px;line-height:24px;font-weight:bold;\">Total <span style=\"font-size:10px;color:#74806e;\">{{currency}}</span></td><td align=\"right\" style=\"padding:17px 0 3px;border-top:1px solid #cfc5b3;color:#263c30;font-size:18px;line-height:24px;font-weight:bold;\">{{total}}</td></tr>\n",
    "css": "html,body{margin:0!important;padding:0!important;width:100%!important;}table,td{mso-table-lspace:0pt;mso-table-rspace:0pt;}img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;}a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important;}@media only screen and (max-width:480px){.outer-pad{padding:8px 6px!important;}.content-pad{padding-left:18px!important;padding-right:18px!important;}.header-label{font-size:8px!important;max-width:72px;}.thumbnail-cell{width:60px!important;padding-right:8px!important;}.product-image{width:52px!important;height:52px!important;}.amount-cell{width:75px!important;font-size:12px!important;}}\n"
  }
}
