# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Dependencies
/node_modules/

# Angular build and generated output
/dist/
/out-tsc/
/bazel-out/
/.angular/
*.tsbuildinfo
/typings/

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# Supabase local state
/supabase/.branches/
/supabase/.temp/
/.supabase/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing and coverage
/coverage/
/__screenshots__/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
*~
.history/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Temporary files and caches
/.cache/
/.tmp/
/tmp/
/temp/
.sass-cache/
*.tmp
*.temp
*.bak
*.backup
/connect.lock

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
