# Server-only configuration. Never place this file's real values under src/.
NODE_ENV=development
BFF_ENABLED=false
BFF_ORIGIN=http://localhost:4300
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_key
REDIS_URL=redis://127.0.0.1:6379
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BFF_SESSION_KEY=replace_with_32_random_bytes_base64
PORT=3000
